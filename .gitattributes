# Git stores and checks out LF, whatever a contributor's core.autocrlf says.
# .editorconfig asks editors for LF; this makes it a guarantee, and rustfmt
# (newline_style = "Unix") agrees.
* text=auto eol=lf

# Hunk headers name the enclosing fn/impl or heading instead of a line number.
*.rs diff=rust
*.md diff=markdown

# Fuzz seeds are exact bytes, some of them text-like (names, HTTP headers,
# filter lists). Never convert their line endings: a changed byte is a
# different input.
fuzz/seeds/** -text

# Binary formats: never normalise, never diff as text.
*.bin binary
*.png binary
*.jpg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.gz binary

# Generated and committed: collapsed in pull request diffs, left out of
# language statistics. CI checks openapi.json and schema.d.ts against the code.
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
crates/goethite-api/openapi.json linguist-generated=true
web/src/api/schema.d.ts linguist-generated=true
