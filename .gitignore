# Rust (Cargo.lock is committed on purpose, for reproducible builds)
/target/
**/*.rs.bk

# Fuzzing (seeds live in fuzz/seeds/ and are committed)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Lists downloaded with the example config
/config/lists/

# Web UI (web/dist is built, then embedded into the binary)
/web/node_modules/
/web/dist/
/web/dist-docs/
/web/test-results/
/web/playwright-report/

# Website
/site/node_modules/
/site/dist/
/site/.astro/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local environment values (tokens included) are never committed; the
# variables goethite reads are documented in .env.example. This only works
# for files: git cannot re-include a path inside an ignored directory.
.env
.env.*
!.env.example
