# Every environment variable goethite reads, with its default. Copy this file
# to `.env` (git-ignored) for local values:
#
#     cp .env.example .env
#
# Nothing loads it on its own: goethite reads the process environment and has
# no dotenv support. Use `set -a; . ./.env; set +a`, direnv, or, in
# production, systemd's `Environment=` / `EnvironmentFile=`. Keep this file
# in step with the code: a variable not listed here cannot be discovered.
#
# Configuration proper lives in the TOML file (config/goethite.example.toml)
# and the replicated store, not here.

# --- goethite run --------------------------------------------------------------

# Log filter (tracing-subscriber EnvFilter syntax). Unset means `info`.
# hickory_proto stays silent unless named here explicitly.
RUST_LOG=info

# --- goethite tui ----------------------------------------------------------------

# The API to talk to; `--api` wins. Unset means http://127.0.0.1:8053.
GOETHITE_API=http://127.0.0.1:8053

# An admin token from `goethite token` (gth_...); `--token-file` wins. A secret:
# listed by name only, never with a value, here or anywhere in the repository.
GOETHITE_TOKEN=

# --- Set by systemd or by goethite itself; never set these by hand -----------------
#
# NOTIFY_SOCKET                           readiness notifications and the FD store (Type=notify)
# LISTEN_PID, LISTEN_FDS, LISTEN_FDNAMES  sockets systemd hands back from its FD store
# STATE_DIRECTORY                         the unit's StateDirectory=; else the config file's directory
# RUNTIME_DIRECTORY                       the unit's RuntimeDirectory=, for the upgrade socket
# GOETHITE_HANDOFF                        set by a running goethite for the process taking over
#                                         its sockets during a zero-downtime upgrade
#
# --- Development and CI only ----------------------------------------------------
#
# GOETHITE_UPDATE_OPENAPI=1   rewrite crates/goethite-api/openapi.json from the code
#                             (cargo test -p goethite-api --test openapi)
# GOETHITE_ROOT_TESTS=1       run the privilege-dropping test, which needs root
# GOETHITE_BIN=<path>         the goethite binary web/'s end-to-end tests start
