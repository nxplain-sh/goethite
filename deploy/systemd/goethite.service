# Hardened systemd unit for goethite.
#
# Install the binary as /usr/bin/goethite and the config as
# /etc/goethite/goethite.toml, then run `systemctl enable --now goethite`.
# goethite runs as a dynamic, unprivileged user. It may bind ports below 1024
# and gives that right up once its sockets are bound. Downloaded filter lists
# belong in /var/lib/goethite, the only writable directory:
#
#   [filter]
#   cache_dir = "/var/lib/goethite/lists"
#
# `systemctl reload goethite` re-reads the filter lists and the TLS
# certificates (SIGHUP). goethite reads TLS keys as its dynamic user: give it
# a group that may read them (SupplementaryGroups=, in a drop-in); see the
# site's "Encrypted DNS" page.
# After installing a new binary, upgrade without dropping a query:
#
#   systemctl kill --signal=SIGUSR2 --kill-whom=main goethite
#
# goethite starts the new binary, hands it its sockets and its store, and
# exits once the new one answers. Its sockets also stay with systemd, so a
# restart after a crash queues queries instead of refusing them.
# `systemd-analyze security goethite` reviews the sandbox.

[Unit]
Description=goethite DNS filtering resolver
Documentation=https://nxplain-sh.github.io/goethite/
Wants=network-online.target nss-lookup.target
After=network-online.target
Before=nss-lookup.target

[Service]
# goethite says when it answers, and after an upgrade the new process
# reports itself as the main one.
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/goethite run --config /etc/goethite/goethite.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# Listening sockets kept across restarts: more than goethite ever has.
FileDescriptorStoreMax=2048
# Every UDP query in flight forwards over its own socket.
LimitNOFILE=65536

# Identity and files.
DynamicUser=yes
StateDirectory=goethite
StateDirectoryMode=0750
# The private socket an upgrade hands everything over on.
RuntimeDirectory=goethite
RuntimeDirectoryMode=0700
ConfigurationDirectory=goethite
UMask=0077

# Privileges: binding port 53 only, and no way to gain more.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
SecureBits=noroot-locked

# File system.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and host.
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed

# Network: IP sockets, and Unix sockets for telling systemd how goethite is
# doing and for upgrades. Logs go to the journal through standard error,
# which systemd connects before starting the service.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System calls: what services usually need, minus the privileged ones.
# capset stays allowed: goethite uses it to give up its capability.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# goethite then confines itself further with Landlock and seccomp; older
# systemd versions leave these calls out of @system-service.
SystemCallFilter=seccomp landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=capset
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
