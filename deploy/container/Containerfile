# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

# goethite's container image: the release binary on Google's distroless image
# for glibc programs (glibc, libgcc, CA certificates and time zone data, no
# shell or package manager).
#
# `cargo xtask image` builds it from the release tarballs in target/dist, for
# each architecture there is one of; nothing is compiled here, and the image
# is as reproducible as the tarballs. The Containerfile syntax above and the
# base image below are pinned by digest for the same reason, and Renovate
# moves the digests.
#
# goethite starts as root, binds port 53, then switches to the image's
# unprivileged `nonroot` user (65532) and gives up every capability before it
# reads the store or a packet, as it does on a host without systemd. Not every
# runtime lets an unprivileged process bind port 53, so starting as root is
# what works everywhere (ADR 0027). Where the runtime allows it, start it as
# 65532 with no capabilities at all: compose.yaml beside this file does, with
# a read-only root file system (ADR 0036).
#
#   docker compose up -d        # or podman compose, in this directory
#
#   docker run -d --name goethite -p 53:53/udp -p 53:53/tcp \
#     -v goethite:/var/lib/goethite ghcr.io/nxplain-sh/goethite:<version>
#
# Mount your own config over /etc/goethite/goethite.toml to change anything;
# the site's install guide has the details.

FROM gcr.io/distroless/cc-debian13@sha256:159783207c2cd44c2aa5715961d13c8612368ac9bd450f887e3f08fc8ea461e3

ARG TARGETARCH
COPY --chmod=0755 goethite-${TARGETARCH} /usr/bin/goethite
COPY --chmod=0644 notices-${TARGETARCH}.txt /usr/share/doc/goethite/THIRD-PARTY-LICENSES.txt
COPY --chmod=0644 LICENSE /usr/share/doc/goethite/
# Directories from an empty one first: a --chmod on a file would also give
# the directory it creates the file's mode.
COPY --chmod=0755 empty/ /etc/goethite/
# Local lists: the only directory goethite reads lists given by a path from.
COPY --chmod=0755 empty/ /etc/goethite/lists/
COPY --chmod=0644 goethite.toml /etc/goethite/goethite.toml
# The store and the downloaded lists: owned by the user goethite runs as.
COPY --chown=65532:65532 --chmod=0750 empty/ /var/lib/goethite/
VOLUME ["/var/lib/goethite"]

# The release's version and commit, from `cargo xtask image`; last, so the
# layers above do not depend on them.
ARG VERSION
ARG REVISION
# The source label links the image to the repository on ghcr.io. ghcr.io reads
# a multi-architecture image's description from its index instead, so `cargo
# xtask image` copies these labels there too: keep one per line.
LABEL org.opencontainers.image.title="goethite" \
      org.opencontainers.image.description="goethite: a self-hosted, security-hardened DNS filtering resolver" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/nxplain-sh/goethite" \
      org.opencontainers.image.url="https://nxplain-sh.github.io/goethite/" \
      org.opencontainers.image.documentation="https://nxplain-sh.github.io/goethite/install/" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

EXPOSE 53/udp 53/tcp
ENTRYPOINT ["/usr/bin/goethite"]
CMD ["run", "--config", "/etc/goethite/goethite.toml"]
