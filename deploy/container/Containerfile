# goethite's container image: the release binary on Google's distroless image
# for glibc programs (glibc, libgcc, CA certificates and time zone data, no
# shell or package manager).
#
# `cargo xtask image` builds it from the release tarballs in target/dist, for
# each architecture there is one of; nothing is compiled here, and the image
# is as reproducible as the tarballs.
#
# goethite starts as root, binds port 53, then switches to the image's
# unprivileged `nonroot` user (65532) and gives up every capability before it
# reads the store or a packet, as it does on a host without systemd. Not every
# runtime lets an unprivileged process bind port 53, so starting as root is
# what works everywhere; with `--user 65532`, goethite runs as that user from
# the start where the runtime allows it.
#
#   docker run -d --name goethite -p 53:53/udp -p 53:53/tcp \
#     -v goethite:/var/lib/goethite ghcr.io/nxplain-sh/goethite:<version>
#
# Mount your own config over /etc/goethite/goethite.toml to change anything;
# the site's install guide has the details.

FROM gcr.io/distroless/cc-debian12@sha256:e5d81ddde149641e2a9ba55be4545bc125c67de07508b03ba4c22e6eb0ded5aa

ARG TARGETARCH
COPY --chmod=0755 goethite-${TARGETARCH} /usr/bin/goethite
# Directories from an empty one first: a --chmod on a file would also give
# the directory it creates the file's mode.
COPY --chmod=0755 empty/ /etc/goethite/
COPY --chmod=0644 goethite.toml /etc/goethite/goethite.toml
# The store and the downloaded lists: owned by the user goethite runs as.
COPY --chown=65532:65532 --chmod=0750 empty/ /var/lib/goethite/
VOLUME ["/var/lib/goethite"]

# The source label links the image to the repository on ghcr.io.
LABEL org.opencontainers.image.source="https://github.com/nxplain-sh/goethite" \
      org.opencontainers.image.description="goethite: a self-hosted, security-hardened DNS filtering resolver" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

EXPOSE 53/udp 53/tcp
ENTRYPOINT ["/usr/bin/goethite"]
CMD ["run", "--config", "/etc/goethite/goethite.toml"]
