{
  "name": "goethite-web",
  "private": true,
  "type": "module",
  "description": "The goethite web UI: a single-page app embedded into the goethite binary.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/budget.mjs && node scripts/docs.mjs",
    "check": "tsc --noEmit",
    "api": "openapi-typescript ../crates/goethite-api/openapi.json --output src/api/schema.d.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tanstack/charts": "1.0.0",
    "@tanstack/react-charts": "1.0.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/react-virtual": "3.14.13",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@scalar/api-reference": "1.73.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
